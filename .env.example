# --- Apps Script bridge (server-side only, never sent to the browser) ---

# The "Web app URL" you get after deploying apps-script/Code.gs
# (Deploy → New deployment → Web app). Looks like:
# https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec
APPS_SCRIPT_URL=

# Must exactly match the SHARED_SECRET Script Property you set on the
# Apps Script project (Project Settings → Script Properties).
# Generate one with: openssl rand -hex 32
APPS_SCRIPT_SHARED_SECRET=

# --- Admin area ---

# Password to log into /admin. Pick something the welcome team can
# share verbally, not something guessable.
ADMIN_PASSWORD=

# Separate random string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- New-guest form ---

# URL of your existing Google Form for first-time guests. The "I'm new
# here" button on the home page links straight to this. If left unset,
# that button shows a "please see someone at the welcome desk" message
# instead of a dead link.
NEW_MEMBER_FORM_URL=
